# What `gcloud builds submit` uploads. Without this file gcloud would use
# .gitignore, which excludes the model files the API image needs.
.*/
docs/
**/.venv/
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.db
**/.env
**/.env.*
frontend/dist/
backend/app/uploads/
backend/reports/
ml/data/
ml/artifacts/*
!ml/artifacts/resnet50_oral_cancer_v7.pt
!ml/artifacts/oral_photo_gate_v1.pt
!ml/artifacts/resnet50_dysplasia_grade_v2.pt
