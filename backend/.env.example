# Production refuses to start with this placeholder or any key under 32
# characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENVIRONMENT=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Self sign-up. Defaults to true in development and false in production,
# where clinician accounts should be created deliberately.
# ALLOW_REGISTRATION=false

# Failed logins allowed per (IP, email) in the window before a 429 lockout.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Postgres (run `docker compose up -d db` to start one locally on :5434 --
# not the default 5432, in case a native Postgres install already owns it).
# Alembic is the source of truth for the schema when using Postgres, so
# table creation on startup is turned off -- run `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://oral_cancer:oral_cancer_dev@localhost:5434/oral_cancer
AUTO_CREATE_TABLES=false

# No-Docker fallback: a local SQLite file, auto-created on startup.
# DATABASE_URL=sqlite:///./oral_cancer.db
# AUTO_CREATE_TABLES=true

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
UPLOAD_DIR=./app/uploads
MAX_FILE_SIZE_MB=10

# Generated PDF reports. Must NOT be inside UPLOAD_DIR, which is served
# without authentication. Reports are regenerated on demand if missing.
REPORT_DIR=./reports

# Optional trained checkpoint (see ml/artifacts/model_card.md). Unset = every
# prediction stays "Pending". This is a research model with documented
# limitations on real clinical photos -- read the model card before enabling.
# MODEL_PATH=../ml/artifacts/resnet50_oral_cancer_v4.pt

# P(Cancer) cut-off for the Cancer label. 0.5 = plain argmax. Lower it to miss
# fewer cancers at the cost of more false alarms -- a clinical decision; see
# the validation threshold table in the model card.
CANCER_THRESHOLD=0.5
