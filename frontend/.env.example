# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored; this file is committed as the reference.

# Base URL of the FastAPI backend.
# Must match an origin allowed by CORS_ORIGINS in backend/.env.
VITE_API_BASE_URL=http://localhost:8000

# true  = the API layer in src/api/ serves local fixtures (no backend needed;
#         useful for UI work and demos).
# false = talk to the real backend. Every endpoint is implemented; predictions
#         stay "Pending" unless the backend has MODEL_PATH configured.
VITE_USE_MOCKS=false
